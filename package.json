{
  "name": "control",
  "productName": "control",
  "version": "0.5.1",
  "description": "Lecteur musique et vidéo, téléchargements yt-dlp et bibliothèque, dans un style macOS.",
  "author": "nildontsleep",
  "desktopName": "control.desktop",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:portable": "electron-builder --win portable --x64 --publish never",
    "dist:setup": "electron-builder --win nsis --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --x64 --publish never"
  },
  "dependencies": {
    "music-metadata": "12.2.3",
    "node-taglib-sharp": "6.0.3"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "homepage": "https://github.com/nildontsleep/control",
  "repository": {
    "type": "git",
    "url": "https://github.com/nildontsleep/control.git"
  },
  "build": {
    "appId": "com.nildontsleep.control",
    "productName": "control",
    "copyright": "Copyright © 2026 nildontsleep",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "THIRD-PARTY.md"
    ],
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "control",
      "uninstallDisplayName": "control",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "fr_FR",
        "en_US"
      ],
      "runAfterFinish": true,
      "artifactName": "control-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "control-${version}-portable.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo;Audio;Player",
      "syncDesktopName": true,
      "executableName": "control",
      "synopsis": "Lecteur musique et vidéo",
      "maintainer": "nildontsleep <132806671+nildontsleep@users.noreply.github.com>",
      "mimeTypes": [
        "audio/mpeg",
        "audio/flac",
        "audio/mp4",
        "audio/ogg",
        "audio/x-wav",
        "audio/opus",
        "video/mp4",
        "video/x-matroska",
        "video/webm"
      ],
      "desktop": {
        "entry": {
          "Name": "control",
          "GenericName": "Lecteur multimédia",
          "Keywords": "music;video;player;yt-dlp;musique;vidéo;",
          "StartupWMClass": "control"
        }
      }
    },
    "appImage": {
      "artifactName": "control-${version}-x86_64.${ext}"
    },
    "deb": {
      "artifactName": "control-${version}-amd64.${ext}",
      "packageCategory": "sound",
      "recommends": [
        "unzip",
        "xz-utils"
      ]
    }
  }
}
